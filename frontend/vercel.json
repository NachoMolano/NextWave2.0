{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://REPLACE-WITH-BACKEND-HOST/api/:path*" },
    { "source": "/health", "destination": "https://REPLACE-WITH-BACKEND-HOST/health" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
