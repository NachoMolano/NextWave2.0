# Where the dev server forwards /api and /health. The browser never talks to the backend
# directly in development, so no CORS policy has to exist for the demo to work.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Only for a deployed build where the portal and the API are on different origins. Leave it
# unset in development. The portal reaches the database through /api or not at all -- there is
# no Supabase client in this app and there must not be one.
# VITE_API_BASE_URL=
