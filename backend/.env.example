# The authoritative list of keys. Copy to .env and fill in. .env is gitignored and never
# committed; if a key does get committed, rotate it immediately and tell the team.
#
# Every value here is empty on purpose. A default that silently does nothing is worse than a
# crash, and a default price cap would be a mandate nobody granted.

# --- Voice and telephony (Vapi) -------------------------------------------------------
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Sent by Vapi as the X-Vapi-Secret header. Verified before a webhook body is parsed.
VAPI_SERVER_SECRET=
# Model, voice and transcriber ids move, and most tutorials online are stale. Verify each
# against current Vapi docs before filling these in. Never hardcode one in source.
VAPI_MODEL=
VAPI_VOICE_ID=
VAPI_TRANSCRIBER=
# Seconds Vapi waits for our tool server. Max is 300; the default is undocumented, so it is
# set explicitly rather than inherited.
VAPI_TOOL_TIMEOUT_SECONDS=20

# --- Persistence ----------------------------------------------------------------------
SUPABASE_URL=
# The service key. Server-side only -- never in dashboard/.
SUPABASE_SECRET_KEY=

# --- Post-call extraction only. Never in the conversational path. ---------------------
OPENAI_API_KEY=
OPENAI_REPORT_MODEL=

# --- The outbox -----------------------------------------------------------------------
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
NOTIFY_FROM_NAME=Volta
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
MANAGER_EMAIL=
MANAGER_WHATSAPP=

# --- Human portal authority ----------------------------------------------------------
# Required for /api. Request bodies cannot select the audit actor.
PORTAL_API_TOKEN=
PORTAL_MANAGER_IDENTITY=

# --- Escalation -----------------------------------------------------------------------
# Where a live call is transferred when the agent hands off to a person.
ESCALATION_PHONE_NUMBER=

# --- The company the agent works for. Rendered into every prompt. ---------------------
COMPANY_NAME=Pacific Textiles
COMPANY_BUSINESS_TYPE=importer
COMPANY_CITY=Guadalajara
COMPANY_COUNTRY=Mexico
COMPANY_CURRENCY=USD
COMPANY_TIMEZONE=America/Mexico_City
COMPANY_PRIMARY_LANGUAGE=en
COMPANY_FALLBACK_LANGUAGE=es-MX
AGENT_NAME=Volta
AGENT_ROLE=transport coordinator

# --- Orchestration --------------------------------------------------------------------
# The brief requires at least three carriers quoted in parallel.
RFQ_CARRIER_COUNT=3
# Vapi allows 10 concurrent calls by default; stay under it so a retry has room.
MAX_CONCURRENT_CALLS=8
RFQ_TIMEOUT_MINUTES=15
SWEEP_INTERVAL_SECONDS=60

# ngrok URL in local development. It changes on every ngrok restart -- re-point the Vapi
# phone number's server URL or inbound calls silently fail.
PUBLIC_BASE_URL=
# Recording is off unless explicitly enabled. If enabled in production, the notice must
# contain the customer-approved consent disclosure used by the call flow.
RECORDING_ENABLED=false
RECORDING_CONSENT_NOTICE=
# Explicit production gates. Set true only after the named control has been implemented and
# evidenced for the deployment; local/demo do not read these as claims of readiness.
PRODUCTION_TENANT_AUTH_READY=false
PRODUCTION_RETENTION_READY=false
PRODUCTION_PROVIDER_DELETION_READY=false
PRODUCTION_LEGAL_REVIEW_READY=false
ENVIRONMENT=local
